ARG LLAMA_CPP_VERSION=8606

# Download pre-built llama-server and libraries
FROM --platform=$TARGETPLATFORM debian:bookworm-slim AS llama-download

ARG LLAMA_CPP_VERSION
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tar \
    && rm -rf /var/lib/apt/lists/*

RUN if [ "$TARGETARCH" = "amd64" ]; then \
      LLAMA_ARCH="x64"; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
      LLAMA_ARCH="arm64"; \
    else \
      echo "Unsupported arch: $TARGETARCH" && exit 1; \
    fi && \
    curl -fSL -o /tmp/llama.tar.gz \
      "https://github.com/ggml-org/llama.cpp/releases/download/b${LLAMA_CPP_VERSION}/llama-b${LLAMA_CPP_VERSION}-bin-ubuntu-${LLAMA_ARCH}.tar.gz" && \
    mkdir -p /tmp/llama && \
    tar xzf /tmp/llama.tar.gz --strip-components=1 -C /tmp/llama/

# Runtime stage
FROM --platform=$TARGETPLATFORM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libcurl4t64 \
    libgcc-s1 \
    libstdc++6 \
    libsqlite3-0 \
    libgomp1 \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install spaCy and FastAPI for dependency parsing (system-wide, no venv needed)
RUN pip3 install --no-cache-dir --break-system-packages spacy fastapi uvicorn pydantic && \
    pip3 install --no-cache-dir --break-system-packages https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl#egg=en_core_web_sm

RUN mkdir -p /data/models

# picobrain binary is injected by goreleaser
COPY picobrain /usr/local/bin/picobrain

# Copy llama-server and all .so files to /usr/local/bin/ so ggml_backend_load_all can find them
COPY --from=llama-download /tmp/llama/llama-server /usr/local/bin/llama-server
COPY --from=llama-download /tmp/llama/*.so* /usr/local/bin/

RUN echo "/usr/local/bin" > /etc/ld.so.conf.d/llama.conf && ldconfig

# Copy spacy server for dependency parsing
COPY spacy_server/ /app/spacy_server/
ENV PICOBRAIN_SPACY_DIR=/app/spacy_server

VOLUME ["/data"]

ENTRYPOINT ["picobrain"]
